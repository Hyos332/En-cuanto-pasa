# Puerto local/container
PORT=3000

# Slack: modo recomendado si el bot es de un solo workspace
SLACK_BOT_TOKEN=xoxb-tu-token
SLACK_SIGNING_SECRET=tu-signing-secret

# URL publica usada para enlaces del dashboard enviados por Slack
PUBLIC_BASE_URL=https://en-cuanto-pasa.ctdesarrollo-sdr.org

# Kronos: debe tener al menos 16 caracteres.
# Si cambias este valor, las credenciales guardadas antes no se podran descifrar.
KRONOS_CREDENTIALS_SECRET=pon-aqui-una-clave-larga-y-estable
KRONOS_MAX_CONCURRENCY=1
KRONOS_NAVIGATION_TIMEOUT_MS=45000

# TUS Santander
TUS_REQUEST_TIMEOUT_MS=8000

# /semanal: permisos y objetivos. Puedes dejar los defaults del codigo si no los necesitas.
SEMANAL_ALLOWED_USERNAMES=diego.moys
SEMANAL_ALLOWED_USER_IDS=
SEMANAL_WEEKLY_TARGETS=Diego Moys=30,Bryan Baquedano=25,Carlos Alvarado=20,Diego Jimenez=25,Angel Romero=25,Marco Figueroa=20,Luis Felipe Hoyos=20,Kevin Ponce=20,Katerine Rafael=20

# Google Sheets para /semanal. Dejalo en false si no sincronizas a Sheets.
SEMANAL_GSHEETS_ENABLED=false
SEMANAL_GSHEETS_SPREADSHEET_ID=
SEMANAL_GSHEETS_SHEET_NAME=Horas Extra Bot
SEMANAL_GSHEETS_CREDENTIALS_BASE64=
SEMANAL_GSHEETS_CREDENTIALS_JSON=

# Docker usa /usr/bin/chromium-browser. En local ajustalo si Chromium esta en otra ruta.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Monitor del servidor por Slack (/server o /servidor)
SERVER_MONITOR_HOST=172.22.9.2
SERVER_MONITOR_PORT=22
SERVER_MONITOR_USERNAME=
# Usa password o llave privada. Recomendado: llave privada.
SERVER_MONITOR_PASSWORD=
SERVER_MONITOR_PRIVATE_KEY=
SERVER_MONITOR_PRIVATE_KEY_PATH=
SERVER_MONITOR_PASSPHRASE=
SERVER_MONITOR_READY_TIMEOUT_MS=10000
SERVER_MONITOR_COMMAND_TIMEOUT_MS=12000
SERVER_MONITOR_DISK_PATHS=/

# Alertas automaticas hacia Slack. El comando manual funciona aunque esto este en false.
SERVER_MONITOR_ENABLED=false
SERVER_MONITOR_ALERT_CHANNEL_ID=
SERVER_MONITOR_POLL_INTERVAL_MS=300000
SERVER_MONITOR_ALERT_COOLDOWN_MS=1800000
SERVER_MONITOR_ALLOWED_USERNAMES=
SERVER_MONITOR_ALLOWED_USER_IDS=

# Umbrales de warning/critico
SERVER_MONITOR_CPU_WARN_PERCENT=85
SERVER_MONITOR_CPU_CRITICAL_PERCENT=95
SERVER_MONITOR_MEMORY_WARN_PERCENT=85
SERVER_MONITOR_MEMORY_CRITICAL_PERCENT=95
SERVER_MONITOR_SWAP_WARN_PERCENT=50
SERVER_MONITOR_SWAP_CRITICAL_PERCENT=80
SERVER_MONITOR_DISK_WARN_PERCENT=85
SERVER_MONITOR_DISK_CRITICAL_PERCENT=95
SERVER_MONITOR_LOAD_WARN_PER_CORE=1.5
SERVER_MONITOR_LOAD_CRITICAL_PER_CORE=2.5
SERVER_MONITOR_PROCESS_MEMORY_WARN_PERCENT=50
SERVER_MONITOR_PROCESS_CPU_WARN_PERCENT=90
