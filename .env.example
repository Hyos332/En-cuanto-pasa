# Puerto local/container
PORT=3000

# Slack: modo recomendado si el bot es de un solo workspace
SLACK_BOT_TOKEN=xoxb-tu-token
SLACK_SIGNING_SECRET=tu-signing-secret

# URL publica usada para enlaces del dashboard enviados por Slack
PUBLIC_BASE_URL=https://en-cuanto-pasa.ctdesarrollo-sdr.org

# Kronos: debe tener al menos 16 caracteres.
# Si cambias este valor, las credenciales guardadas antes no se podran descifrar.
KRONOS_CREDENTIALS_SECRET=pon-aqui-una-clave-larga-y-estable
KRONOS_MAX_CONCURRENCY=1
KRONOS_NAVIGATION_TIMEOUT_MS=45000

# TUS Santander
TUS_REQUEST_TIMEOUT_MS=8000

# /semanal: permisos y objetivos. Puedes dejar los defaults del codigo si no los necesitas.
SEMANAL_ALLOWED_USERNAMES=diego.moys
SEMANAL_ALLOWED_USER_IDS=
SEMANAL_WEEKLY_TARGETS=Diego Moys=30,Bryan Baquedano=25,Carlos Alvarado=20,Diego Jimenez=25,Angel Romero=25,Marco Figueroa=20,Luis Felipe Hoyos=20,Kevin Ponce=20,Katerine Rafael=20

# Google Sheets para /semanal. Dejalo en false si no sincronizas a Sheets.
SEMANAL_GSHEETS_ENABLED=false
SEMANAL_GSHEETS_SPREADSHEET_ID=
SEMANAL_GSHEETS_SHEET_NAME=Horas Extra Bot
SEMANAL_GSHEETS_CREDENTIALS_BASE64=
SEMANAL_GSHEETS_CREDENTIALS_JSON=

# Docker usa /usr/bin/chromium-browser. En local ajustalo si Chromium esta en otra ruta.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
